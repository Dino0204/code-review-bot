# ── 웹훅 서버(도커)용 ────────────────────────────────────────────
# GSML API 키 — https://gsmsv.site 에서 발급. 모든 리뷰가 이 키 하나를 쓴다.
GSML_API_KEY=

# GitHub App 설정 상단의 App ID (숫자)
GITHUB_APP_ID=

# App에 등록한 웹훅 시크릿과 같은 값이어야 한다
GITHUB_WEBHOOK_SECRET=

# 리뷰를 허용할 리포지토리 (owner/repo, 쉼표 구분).
# 비우면 App이 설치된 모든 리포지토리를 리뷰한다 — 키 할당량이 새어나갈 수 있다.
REVIEWBOT_ALLOWED_REPOS=

# 모델 서버 주소. 서버와 같은 호스트에서 돌린다면 localhost로 두는 편이 낫다
# REVIEWBOT_BASE_URL=http://ssh.gsmsv.site:26145/v1

# 개인키는 secrets/app-private-key.pem 에 두면 compose가 마운트한다.
# 파일 대신 값으로 주려면 GITHUB_APP_PRIVATE_KEY 를 쓴다.

# ── 로컬 CLI(npm run review)용 ──────────────────────────────────
# 서버와 달리 App이 아니라 개인 토큰을 쓴다
GITHUB_TOKEN=

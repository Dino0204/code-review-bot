# ── 웹훅 서버(도커)용 ────────────────────────────────────────────
# 모델 provider 키. providers.yml 이 ${...} 로 참조한다.
# 키가 없는 provider 는 체인에서 빠지고, 전부 비면 부팅이 실패한다.
GOOGLE_API_KEY=
GLM_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# GitHub App 설정 상단의 App ID (숫자)
GITHUB_APP_ID=

# App에 등록한 웹훅 시크릿과 같은 값이어야 한다
GITHUB_WEBHOOK_SECRET=

# 큐와 리뷰 상태를 담는 Redis. compose 로 띄우면 compose 가 채우므로 비워둔다.
# REDIS_URL=redis://127.0.0.1:6379

# provider 체인 정의 파일. compose 는 이미지 안의 것을 마운트로 덮는다.
# PROVIDERS_FILE=./providers.yml

# 개인키는 secrets/app-private-key.pem 에 두면 compose가 마운트한다.
# 파일 대신 값으로 주려면 GITHUB_APP_PRIVATE_KEY 를 쓴다.

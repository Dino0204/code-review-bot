{
	"name": "colombina-code-review-bot",
	"version": "0.1.0",
	"description": "GitHub Pull Request 코드 리뷰 봇 — gemini-code-assist 대체용",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"format": "npx @biomejs/biome format --write",
		"line": "npx @biomejs/biome lint --write",
		"check": "npx @biomejs/biome check --write",
		"ci:biome": "npx @biomejs/biome ci .",
		"start": "node dist/modules/server/index.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/it-play/Code-Review-Bot.git"
	},
	"license": "MIT",
	"dependencies": {
		"@octokit/auth-app": "^8.3.0",
		"@octokit/core": "^7.0.7",
		"@octokit/plugin-retry": "^8.1.1",
		"@octokit/request-error": "^7.1.1",
		"@octokit/rest": "^22.0.1",
		"minimatch": "^10.2.6",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/node": "^26.1.2",
		"esbuild": "^0.28.1",
		"tsc-alias": "^1.9.2",
		"typescript": "^7.0.2"
	},
	"main": "dist/modules/server/index.js"
}
